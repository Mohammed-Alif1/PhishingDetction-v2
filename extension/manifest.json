{
    "manifest_version": 3,
    "name": "SentinelAI - Phishing Detector",
    "version": "2.1.0",
    "description": "Automatic phishing detection powered by machine learning",
    "permissions": [
        "activeTab",
        "tabs"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "SentinelAI"
    }
}